<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AssistantX" parent="android:Theme.Material.Light.NoActionBar">
        <!-- 100% True Translucent & Transparent Window Configuration -->
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">#070A0F</item>
        <item name="android:colorBackground">#070A0F</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>

        <!-- Prevent Android 12+ Splash Screen from forcing a solid color -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowSplashScreenBackground">#070A0F</item>

        <!-- Prevent Android transition animations from drawing a black frame -->
        <item name="android:windowAnimationStyle">@null</item>
        
        <!-- System bar transparency without black bars -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>